{
  "name": "baycopier",
  "version": "0.2.0",
  "private": true,
  "description": "Firefox extension that copies an eBay sold listing's description and photos into a new listing.",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "web-ext lint --source-dir extension",
    "start": "web-ext run --source-dir extension --start-url https://www.ebay.com",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "web-ext": "^10.8.0"
  }
}
